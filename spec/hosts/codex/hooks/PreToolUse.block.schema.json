{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "codex PreToolUse block",
  "type": "object",
  "required": ["hookSpecificOutput"],
  "additionalProperties": false,
  "properties": {
    "hookSpecificOutput": {
      "type": "object",
      "required": ["hookEventName", "permissionDecision", "permissionDecisionReason"],
      "additionalProperties": false,
      "properties": {
        "hookEventName":            { "type": "string", "enum": ["PreToolUse"] },
        "permissionDecision":       { "type": "string", "enum": ["deny"] },
        "permissionDecisionReason": { "type": "string" }
      }
    }
  }
}
